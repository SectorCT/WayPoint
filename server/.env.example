# Copy to server/.env and fill in. server/.env is gitignored; never commit it.
# Every variable is optional for local development: docker-compose.yml supplies
# a development default for each one.

# --- Django -----------------------------------------------------------------
# Required whenever DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Defaults to True in docker-compose.yml and False everywhere else.
DEBUG=True
# Comma-separated host names the server answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the API (the Flutter web build), comma-separated,
# e.g. https://app.example.com. CORS_ALLOW_ALL_ORIGINS defaults to the DEBUG value.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=
# Time zone for business dates ("today's packages").
TIME_ZONE=Europe/Sofia

# --- Database ---------------------------------------------------------------
# Postgres only applies these when its data volume is first created. To change
# the password of an existing volume, run ALTER USER in the db container (or
# recreate the volume with `docker compose down -v`).
DB_NAME=waypoint_db
DB_USER=waypoint_user
DB_PASSWORD=

# --- Route optimisation (OSRM) ----------------------------------------------
# Public demo server by default. For the self-hosted container, see README:
#   OSRM_BASE_URL=http://osrm:5000
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_S=20

# --- Email (delivery notifications) -----------------------------------------
# Leave EMAIL_HOST_USER empty to print emails to the server log instead of
# sending them. With Gmail, EMAIL_HOST_PASSWORD must be an App Password.
# Check the setup with: docker compose exec web python manage.py send_test_email you@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
